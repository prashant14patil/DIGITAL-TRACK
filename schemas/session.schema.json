{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaltrack.local/schemas/session.schema.json",
  "title": "Scan session manifest (session.json), dataset schema 0.2.0",
  "description": "0.2.0: RGB video is the primary input; depth is optional. Older sessions keep validating against schemas/v0.1.0/.",
  "type": "object",
  "required": ["schema_version", "session_id", "created_utc", "synthetic", "input_type", "capture", "calibration_id", "frames"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "session_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean", "description": "true for generated data; must never be mixed with real human scans"},
    "input_type": {
      "enum": ["video_rgb", "rgbd_depth", "synthetic_depth", "synthetic_rgb"],
      "description": "Which input adapter produced the session. video_rgb is the primary path."
    },
    "device": {
      "type": "object",
      "description": "Recording device as far as known (e.g. from container metadata). Not required for video.",
      "properties": {
        "model": {"type": "string"},
        "os_version": {"type": "string"},
        "app_version": {"type": "string"},
        "recording_app": {"type": "string"}
      }
    },
    "source_video": {
      "type": "object",
      "description": "Original uploaded video, stored byte-for-byte and read-only under source/.",
      "required": ["file", "sha256", "size_bytes"],
      "properties": {
        "file": {"type": "string", "pattern": "^source/[^/\\\\]+$"},
        "original_filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "probe": {"type": "object", "description": "Container/stream facts from the probe step (see video.probe)."}
      }
    },
    "frame_extraction": {
      "type": "object",
      "description": "How frames were derived from source_video (selection rule, decoder, pixel format, versions).",
      "required": ["method", "parameters", "software"],
      "properties": {
        "method": {"type": "string"},
        "parameters": {"type": "object"},
        "software": {"type": "object"}
      }
    },
    "capture": {
      "type": "object",
      "required": ["camera_fixed", "subject_on_turntable", "rotation_source", "rotation_axis_frame"],
      "properties": {
        "camera_fixed": {"type": "boolean"},
        "subject_on_turntable": {"type": "boolean"},
        "rotation_source": {"enum": ["manual", "marker", "encoder", "synthetic", "none"],
                            "description": "none = angles not yet determined"},
        "rotation_axis_frame": {"type": "string"},
        "protocol_version": {"type": "string"},
        "depth_source": {"type": "string"},
        "depth_unit": {"const": "meters"},
        "depth_dtype": {"const": "float32"}
      }
    },
    "calibration_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "properties": {
        "subject_id": {"type": "string", "description": "pseudonymous identifier only"},
        "clothing": {"type": "string"},
        "posture_notes": {"type": "string"}
      }
    },
    "rig": {
      "type": "object",
      "properties": {
        "rig_id": {"type": "string"},
        "camera_distance_m": {"type": "number"},
        "camera_height_m": {"type": "number"}
      }
    },
    "migrated_from": {
      "type": "object",
      "description": "Present when this session is a migrated copy of an older session.",
      "required": ["schema_version", "session_json_sha256", "migrated_utc", "tool"],
      "properties": {
        "schema_version": {"type": "string"},
        "session_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "migrated_utc": {"type": "string"},
        "tool": {"type": "string"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "dir", "timestamp_s"],
        "properties": {
          "frame_id": {"type": "integer", "minimum": 1},
          "dir": {"type": "string"},
          "timestamp_s": {"type": "number"},
          "turntable_angle_deg": {"type": "number", "description": "RECORDED angle; absent until determined"},
          "rgb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "depth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "confidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "anyOf": [{"required": ["rgb_sha256"]}, {"required": ["depth_sha256"]}]
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"input_type": {"const": "video_rgb"}}},
     "then": {"required": ["source_video", "frame_extraction"]}},
    {"if": {"properties": {"input_type": {"enum": ["rgbd_depth", "synthetic_depth"]}}},
     "then": {"properties": {"capture": {"required": ["depth_source", "depth_unit", "depth_dtype"]}}}}
  ]
}
